{
  "manifest_version": 2,
  "name": "DV Efnisblokkari",
  "version": "2.0.0",
  "description": "Felur efni frá 433 íþróttum, Fókus, Eyju, Kynningum og auglýsingum á dv.is með litaðar útilokun",
  
  "applications": {
    "gecko": {
      "id": "dv-content-blocker@example.com"
    }
  },

  "permissions": [
    "https://www.dv.is/*",
    "storage",
    "tabs"
  ],

  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  },

  "browser_action": {
    "default_title": "DV Efnisblokkari",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["https://www.dv.is/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]}